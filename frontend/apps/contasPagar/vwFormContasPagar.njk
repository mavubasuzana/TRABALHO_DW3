
{% extends "layout.njk" %}

{% block content %}

<header class="mb-4">
    <h1 class="h3 fw-bold">Formulário de Contas a Pagar</h1>
    <p class="text-secondary">
        Cadastre, consulte, atualize ou remova contas a pagar.
    </p>
</header>

<div class="card shadow-sm">
    <div class="card-body p-4">

        <form id="frmContasPagar" data-servidor-dw3="{{ servidorDw3 }}">

            <input
                type="hidden"
                id="contaid"
                name="contaid"
                value="{{ contaid or '0' }}"
            >

            <input
                type="hidden"
                id="oper"
                name="oper"
                value="{{ oper }}"
            >

            <div class="mb-3">
                <label for="fornecedor_id" class="form-label">
                    Fornecedor
                </label>

                <select
                    class="form-select"
                    id="fornecedor_id"
                    name="fornecedor_id"
                    required
                >
                    <option value="">Selecione um fornecedor</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="descricao" class="form-label">
                    Descrição
                </label>

                <input
                    type="text"
                    class="form-control"
                    id="descricao"
                    name="descricao"
                    maxlength="200"
                    required
                >
            </div>

            <div class="mb-3">
                <label for="valor" class="form-label">
                    Valor (R$)
                </label>

                <input
                    type="number"
                    class="form-control"
                    id="valor"
                    name="valor"
                    min="0.01"
                    step="0.01"
                    required
                >
            </div>

            <div class="mb-3">
                <label for="data_vencimento" class="form-label">
                    Data de vencimento
                </label>

                <input
                    type="date"
                    class="form-control"
                    id="data_vencimento"
                    name="data_vencimento"
                    required
                >
            </div>

            <div id="mensagemContaPagar" class="mb-3" role="alert"></div>

            <div class="d-flex flex-wrap gap-2">
                <button
                    type="submit"
                    class="btn btn-primary"
                    id="btnSalvarContaPagar"
                >
                    Salvar
                </button>

                <a href="/contas-pagar" class="btn btn-secondary">
                    Voltar
                </a>
            </div>

        </form>

    </div>
</div>

<script src="/apps/contasPagar/vwFormContasPagar.js"></script>

{% endblock %}
