
{% extends "layout.njk" %}

{% block content %}

<header class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-2">Contas a Pagar</h1>
        <p class="text-secondary mb-0">
            Consulte e gerencie as contas a pagar cadastradas.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a href="/contas-pagar/form?oper=In" class="btn btn-primary">
            Nova conta
        </a>

        <button type="button" class="btn btn-outline-secondary" id="btnMostrarContasRemovidas">
            Mostrar removidas
        </button>
    </div>
</header>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fornecedor</th>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Vencimento</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody
                    id="tblContasPagar"
                    data-servidor-dw3="{{ servidorDw3 }}"
                >
                    <tr>
                        <td colspan="6" class="text-center text-secondary">
                            Carregando contas a pagar...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div id="mensagemContasPagar" role="alert"></div>

    </div>
</div>

<script src="/apps/contasPagar/vwLstContasPagar.js"></script>

{% endblock %}
