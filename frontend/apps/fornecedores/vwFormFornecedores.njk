
{% extends "layout.njk" %}

{% block content %}

<header class="mb-4">
    <h1 class="h3 fw-bold">Formulário de Fornecedores</h1>
    <p class="text-secondary">
        Cadastre, consulte, atualize ou remova fornecedores.
    </p>
</header>

<div class="card shadow-sm">
    <div class="card-body p-4">

        <form id="frmFornecedores" data-servidor-dw3="{{ servidorDw3 }}">

            <input type="hidden" id="fornecedorid" name="fornecedorid"
                value="{{ fornecedorid or '0' }}">

            <input type="hidden" id="oper" name="oper"
                value="{{ oper }}">

            <div class="mb-3">
                <label for="nome" class="form-label">Nome do fornecedor</label>

                <input
                    type="text"
                    class="form-control"
                    id="nome"
                    name="nome"
                    maxlength="150"
                    required
                >
            </div>

            <div class="mb-3">
                <label for="documento" class="form-label">
                    Documento
                </label>

                <input
                    type="text"
                    class="form-control"
                    id="documento"
                    name="documento"
                    maxlength="30"
                >
            </div>

            <div id="mensagemFornecedor" class="mb-3" role="alert"></div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" id="btnSalvarFornecedor">
                    Salvar
                </button>

                <a href="/fornecedores" class="btn btn-secondary">
                    Voltar
                </a>
            </div>

        </form>

    </div>
</div>

<script src="/apps/fornecedores/vwFormFornecedores.js"></script>

{% endblock %}
