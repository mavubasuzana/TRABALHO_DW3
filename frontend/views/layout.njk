
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{{ title or 'Sistema Financeiro' }}</title>

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    >

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    {% if showNavbar %}
    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" href="/home">
                Sistema Financeiro
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Alternar navegação"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a
                            class="nav-link {% if activeMenu == 'fornecedores' %}active{% endif %}"
                            href="/fornecedores"
                        >
                            Fornecedores
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link {% if activeMenu == 'contasPagar' %}active{% endif %}"
                            href="/contas-pagar"
                        >
                            Contas a Pagar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/login" id="btnSair">
                            Sair
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>
    {% endif %}

    <main class="container py-4">
        {% block content %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    {% if showNavbar %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const botaoSair = document.getElementById('btnSair');

            if (botaoSair) {
                botaoSair.addEventListener('click', function (evento) {
                    evento.preventDefault();

                    const confirmado = window.confirm(
                        'Tem a certeza de que deseja sair do sistema?'
                    );

                    if (!confirmado) {
                        return;
                    }

                    sessionStorage.removeItem('tokenDW3');

                    window.location.href = '/login';
                });
            }
        });
    </script>
    {% endif %}

</body>
</html>
